{
  "name": "trainer-dev",
  "version": "0.1.0",
  "private": true,
  "description": "trainer.dev — plataforma gratuita e open source de preparação para entrevistas técnicas, com trilhas por tecnologia (Kafka, Java, Elastic Search).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-search-index.ts",
    "build": "next build",
    "postbuild": "tsx scripts/generate-pdf.ts",
    "start": "serve out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.2.12",
    "@radix-ui/react-dialog": "^1.1.6",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.4.1",
    "next": "^16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.2.12",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "wrangler": "^4.120.0",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
